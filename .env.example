# Copia este archivo con el nombre .env (no se sube al repositorio) para probar en local con
# `npm run dev`. En Vercel se configuran en Settings → Environment Variables, tipo Secret.

# Llave de la cuenta de servicio reservas-web@magiabarber.iam.gserviceaccount.com:
# el contenido COMPLETO del archivo JSON que descarga Google Cloud, en una sola línea.
# Lee la disponibilidad y crea las citas en los calendarios de los barberos.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opcional: respaldo de solo lectura si no hay cuenta de servicio
GOOGLE_CALENDAR_API_KEY=
